        "text": "=:warning: Quiz Auto Grader falló\nQuiz: {{ $('Webhook Calificar').first().json.body.quiz_id }}\nAlumno: {{ $('Webhook Calificar').first().json.body.student_id }}\nError: {{ $json.error?.message ?? JSON.stringify($json.error) }}",
        "otherOptions": {}
      },
      "id": "c1000000-0000-4000-8000-000000000010",
      "name": "Alerta Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [320, 320],
      "credentials": {
        "slackApi": { "id": "SLACK_API", "name": "Slack" }
      }
    },
    {
      "parameters": {
